<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Pinned deliberately. ModelContextProtocol.Core implements spec revision 2026-07-28 and
       negotiates back to older servers; prismatoid is very new (ROADMAP §4, pitfall 7) and is
       wrapped behind IAnnouncer with a working no-op fallback. -->
  <ItemGroup>
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <!-- The Tasks extension (Phase 14), from the same SDK and the same release. Pinned exactly, as the
         package itself pins its ModelContextProtocol dependency to [2.2.0]. -->
    <PackageVersion Include="ModelContextProtocol.Extensions.Tasks" Version="2.2.0" />
    <PackageVersion Include="Prismatoid" Version="0.4.0" />
  </ItemGroup>

  <!-- The only dependency Humcp.Schema takes, and the one deliberate exception to that project
       having none. JSON Schema 2020-12 assertion semantics are a conformance surface, not a
       feature; a hand-rolled subset would quietly disagree with the server about what is valid,
       and the server is the authority (ROADMAP §5). We still write every message ourselves —
       these are spoken, and a library's wording is not. -->
  <ItemGroup>
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>

  <!-- The local model (ROADMAP §11.0): ONNX Runtime GenAI on Windows ML, as the v2 spike measured
       it. Windows ML is under Microsoft's own licence terms rather than an open-source one, shipped
       knowingly (Phase 9): the installer's licence page and the user guide's privacy section say
       what that means for the person using humcp. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI.WinML" Version="0.18.0" />
    <!-- Named rather than left transitive: GenAI asks for 2.1.1 or later, NuGet would take 2.1.1, and
         2.4.89 is the runtime the spike's numbers come from. -->
    <PackageVersion Include="Microsoft.Windows.AI.MachineLearning" Version="2.4.89" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
