<Window x:Class="Humcp.Spike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Humcp.Spike"
        Title="humcp Phase 0 spike"
        Height="760" Width="1180"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <local:AppendHintConverter x:Key="CalendarHint"
                                   Hint="Press Alt plus Down Arrow to open the calendar." />

        <!-- Tier 1: string -> TextBox -->
        <DataTemplate x:Key="TextTemplate">
            <StackPanel Margin="0,8,0,0">
                <Label x:Name="FieldLabel" Padding="0,0,0,2"
                       Content="{Binding LabelWithAccessKey}"
                       Target="{Binding ElementName=FieldInput}" />
                <TextBox x:Name="FieldInput" Tag="input"
                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{Binding Label}"
                         AutomationProperties.HelpText="{Binding HelpText}"
                         AutomationProperties.IsRequiredForForm="{Binding IsRequired}"
                         AutomationProperties.ItemStatus="{Binding ItemStatus}"
                         AutomationProperties.LabeledBy="{Binding ElementName=FieldLabel}" />
            </StackPanel>
        </DataTemplate>

        <!-- Tier 1: string with maxLength > 200 -> multiline TextBox -->
        <DataTemplate x:Key="MultilineTemplate">
            <StackPanel Margin="0,8,0,0">
                <Label x:Name="FieldLabel" Padding="0,0,0,2"
                       Content="{Binding LabelWithAccessKey}"
                       Target="{Binding ElementName=FieldInput}" />
                <TextBox x:Name="FieldInput" Tag="input"
                         AcceptsReturn="True" TextWrapping="Wrap" MinLines="4" MaxLines="8"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{Binding Label}"
                         AutomationProperties.HelpText="{Binding HelpText}"
                         AutomationProperties.IsRequiredForForm="{Binding IsRequired}"
                         AutomationProperties.ItemStatus="{Binding ItemStatus}"
                         AutomationProperties.LabeledBy="{Binding ElementName=FieldLabel}" />
            </StackPanel>
        </DataTemplate>

        <!-- Tier 1: number / integer -> TextBox, deliberately not a spinner (ROADMAP §5) -->
        <DataTemplate x:Key="NumberTemplate">
            <StackPanel Margin="0,8,0,0">
                <Label x:Name="FieldLabel" Padding="0,0,0,2"
                       Content="{Binding LabelWithAccessKey}"
                       Target="{Binding ElementName=FieldInput}" />
                <TextBox x:Name="FieldInput" Tag="input" MaxWidth="220" HorizontalAlignment="Left"
                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{Binding Label}"
                         AutomationProperties.HelpText="{Binding HelpText}"
                         AutomationProperties.IsRequiredForForm="{Binding IsRequired}"
                         AutomationProperties.ItemStatus="{Binding ItemStatus}"
                         AutomationProperties.LabeledBy="{Binding ElementName=FieldLabel}" />
            </StackPanel>
        </DataTemplate>

        <!-- Tier 1: boolean -> CheckBox. The content is the label; no separate Label element. -->
        <DataTemplate x:Key="BoolTemplate">
            <CheckBox x:Name="FieldInput" Tag="input" Margin="0,12,0,0"
                      Content="{Binding LabelWithAccessKey}"
                      IsChecked="{Binding BoolValue, Mode=TwoWay}"
                      AutomationProperties.Name="{Binding Label}"
                      AutomationProperties.HelpText="{Binding HelpText}"
                      AutomationProperties.IsRequiredForForm="{Binding IsRequired}"
                      AutomationProperties.ItemStatus="{Binding ItemStatus}" />
        </DataTemplate>

        <!-- Tier 1: string + enum -> ComboBox, enumNames for display, enum for value -->
        <DataTemplate x:Key="EnumTemplate">
            <StackPanel Margin="0,8,0,0">
                <Label x:Name="FieldLabel" Padding="0,0,0,2"
                       Content="{Binding LabelWithAccessKey}"
                       Target="{Binding ElementName=FieldInput}" />
                <ComboBox x:Name="FieldInput" Tag="input" MaxWidth="320" HorizontalAlignment="Left"
                          ItemsSource="{Binding Choices}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding Value, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding Label}"
                          AutomationProperties.HelpText="{Binding HelpText}"
                          AutomationProperties.IsRequiredForForm="{Binding IsRequired}"
                          AutomationProperties.ItemStatus="{Binding ItemStatus}"
                          AutomationProperties.LabeledBy="{Binding ElementName=FieldLabel}" />
            </StackPanel>
        </DataTemplate>

        <!-- Tier 1: string + format: date -> DatePicker. On trial; see the DateAsText comparison. -->
        <DataTemplate x:Key="DateTemplate">
            <StackPanel Margin="0,8,0,0">
                <Label x:Name="FieldLabel" Padding="0,0,0,2"
                       Content="{Binding LabelWithAccessKey}"
                       Target="{Binding ElementName=FieldInput}" />
                <DatePicker x:Name="FieldInput" Tag="input" MaxWidth="220" HorizontalAlignment="Left"
                            SelectedDate="{Binding DateValue, Mode=TwoWay}"
                            AutomationProperties.Name="{Binding Label}"
                            AutomationProperties.HelpText="{Binding HelpText, Converter={StaticResource CalendarHint}}"
                            AutomationProperties.IsRequiredForForm="{Binding IsRequired}"
                            AutomationProperties.ItemStatus="{Binding ItemStatus}"
                            AutomationProperties.LabeledBy="{Binding ElementName=FieldLabel}" />
            </StackPanel>
        </DataTemplate>

        <!-- The comparison control: same semantic field as a plain ISO 8601 text box. -->
        <DataTemplate x:Key="DateAsTextTemplate">
            <StackPanel Margin="0,8,0,0">
                <Label x:Name="FieldLabel" Padding="0,0,0,2"
                       Content="{Binding LabelWithAccessKey}"
                       Target="{Binding ElementName=FieldInput}" />
                <TextBox x:Name="FieldInput" Tag="input" MaxWidth="220" HorizontalAlignment="Left"
                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{Binding Label}"
                         AutomationProperties.HelpText="{Binding HelpText}"
                         AutomationProperties.IsRequiredForForm="{Binding IsRequired}"
                         AutomationProperties.ItemStatus="{Binding ItemStatus}"
                         AutomationProperties.LabeledBy="{Binding ElementName=FieldLabel}" />
            </StackPanel>
        </DataTemplate>

        <!-- Tier 2: object -> GroupBox, a real UIA group -->
        <DataTemplate x:Key="GroupTemplate">
            <GroupBox Margin="0,12,0,0" Header="{Binding Label}"
                      AutomationProperties.Name="{Binding Label}"
                      AutomationProperties.HelpText="{Binding HelpText}">
                <local:FormItemsControl ItemsSource="{Binding Children}"
                                        ItemTemplateSelector="{DynamicResource FieldSelector}"
                                        VirtualizingStackPanel.IsVirtualizing="False"
                                        Margin="6,0,6,8" />
            </GroupBox>
        </DataTemplate>

        <local:FieldTemplateSelector x:Key="FieldSelector"
            TextTemplate="{StaticResource TextTemplate}"
            MultilineTemplate="{StaticResource MultilineTemplate}"
            NumberTemplate="{StaticResource NumberTemplate}"
            BoolTemplate="{StaticResource BoolTemplate}"
            EnumTemplate="{StaticResource EnumTemplate}"
            DateTemplate="{StaticResource DateTemplate}"
            DateAsTextTemplate="{StaticResource DateAsTextTemplate}"
            GroupTemplate="{StaticResource GroupTemplate}" />

    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Return" Modifiers="Control" Command="{x:Static local:MainWindow.SubmitCommand}" />
        <KeyBinding Key="F6" Command="{x:Static local:MainWindow.NextPaneCommand}" />
        <KeyBinding Key="F6" Modifiers="Shift" Command="{x:Static local:MainWindow.PreviousPaneCommand}" />
        <KeyBinding Key="F1" Command="{x:Static local:MainWindow.DetailsCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:MainWindow.FocusFilterCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- A Win32 menu bar is not in the tab order: Alt reaches it, then left/right arrows move
             between menus. WPF puts every top-level MenuItem in the tab order unless told not to. -->
        <Menu DockPanel.Dock="Top" AutomationProperties.Name="Main menu"
              Focusable="False" IsTabStop="False"
              KeyboardNavigation.TabNavigation="None">
            <MenuItem Header="_File">
                <MenuItem Header="prism _diagnostics…" Click="OnShowDiagnostics" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="HideOptionalItem" Header="Hide _optional fields"
                          IsCheckable="True" Click="OnRebuildForm" />
                <MenuItem x:Name="VirtualizeItem" Header="_Virtualize the generated form (breaks UIA)"
                          IsCheckable="True" Click="OnToggleVirtualization" />
            </MenuItem>
            <MenuItem Header="_Speech">
                <MenuItem Header="_Speak test phrase" Click="OnSpeakTest" />
                <MenuItem Header="_Braille test phrase" Click="OnBrailleTest" />
                <MenuItem Header="Speech and braille _together" Click="OnOutputTest" />
                <MenuItem Header="Sto_p speech" Click="OnStopSpeech" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="LiveStatus"
                           AutomationProperties.Name="Status"
                           AutomationProperties.LiveSetting="Polite"
                           Text="Ready." />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="220" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="360" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- ================================================= pane 1: the tree -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Servers" FontWeight="Bold"
                           AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,4" />
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Label x:Name="FilterLabel" DockPanel.Dock="Left" Padding="0,0,6,0"
                           Content="F_ilter" Target="{Binding ElementName=FilterBox}" />
                    <TextBox x:Name="FilterBox"
                             AutomationProperties.Name="Filter"
                             AutomationProperties.HelpText="Type-ahead over tool names, titles and descriptions."
                             AutomationProperties.LabeledBy="{Binding ElementName=FilterLabel}"
                             TextChanged="OnFilterChanged" />
                </DockPanel>
                <TreeView x:Name="Tree"
                          AutomationProperties.Name="Servers and tools"
                          VirtualizingStackPanel.IsVirtualizing="False"
                          SelectedItemChanged="OnTreeSelectionChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding AccessibleName}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <!-- IsTabStop, not Focusable: the splitter stays programmatically focusable so a
                 "resize this pane" command can hand it the arrow keys, but Tab walks past it. -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          IsTabStop="False"
                          AutomationProperties.Name="Resize servers pane" />

            <!-- ================================================= pane 2: the generated form -->
            <DockPanel Grid.Column="2">
                <TextBlock x:Name="FormHeading" DockPanel.Dock="Top" FontWeight="Bold"
                           Text="Parameters"
                           AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,4" />

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="SubmitButton" Content="_Run tool" Click="OnSubmit"
                            Padding="12,4" Margin="0,0,8,0"
                            AutomationProperties.HelpText="Validates, then shows a canned result. Ctrl+Enter." />
                    <Button Content="_Add a field" Click="OnAddField" Padding="12,4" Margin="0,0,8,0"
                            AutomationProperties.HelpText="Appends one field to the live form, to test dynamic-addition announcements." />
                    <Button Content="Add 200 _fields" Click="OnAddManyFields" Padding="12,4" Margin="0,0,8,0"
                            AutomationProperties.HelpText="Stress test for tab order and UI virtualization." />
                    <Button Content="_Reset form" Click="OnResetForm" Padding="12,4" />
                </StackPanel>

                <!-- The error summary list of ROADMAP §7.5. -->
                <DockPanel x:Name="ErrorPanel" DockPanel.Dock="Bottom" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorHeading" DockPanel.Dock="Top" FontWeight="Bold" Foreground="#B00020"
                               AutomationProperties.HeadingLevel="Level3"
                               Text="Validation errors" Margin="0,0,0,4" />
                    <ListBox x:Name="ErrorList" MaxHeight="120"
                             DisplayMemberPath="Display"
                             AutomationProperties.Name="Validation errors"
                             AutomationProperties.HelpText="Press Enter to move to the field."
                             KeyDown="OnErrorListKeyDown"
                             MouseDoubleClick="OnErrorListActivated" />
                </DockPanel>

                <local:FormItemsControl x:Name="FormItems"
                              AutomationProperties.Name="Tool parameters"
                              ItemTemplateSelector="{StaticResource FieldSelector}"
                              VirtualizingStackPanel.IsVirtualizing="False"
                              KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer x:Name="FormScroll" CanContentScroll="True" Focusable="False"
                                          VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </local:FormItemsControl>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch"
                          IsTabStop="False"
                          AutomationProperties.Name="Resize parameters pane" />

            <!-- ================================================= pane 3: the result -->
            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="Result" FontWeight="Bold"
                           AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,4" />
                <!-- §7.9: read-only multiline TextBox, never a TextBlock. Caret navigation matters. -->
                <TextBox x:Name="ResultBox"
                         IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         AutomationProperties.Name="Result"
                         AutomationProperties.HelpText="Read-only. Arrow keys review the text line by line."
                         Text="No tool has been run yet." />
            </DockPanel>

        </Grid>
    </DockPanel>
</Window>
