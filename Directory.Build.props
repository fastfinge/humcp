<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Every server-supplied string is untrusted (ROADMAP §4, pitfall 5). Nullable warnings are
         the cheapest guard against a null description reaching a speech synthesiser, so they are
         errors rather than suggestions. -->
    <WarningsAsErrors>nullable</WarningsAsErrors>
  </PropertyGroup>

</Project>
