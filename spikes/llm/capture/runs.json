[
 {"id": "open-meteo", "command": "npx", "args": ["-y", "-p", "open-meteo-mcp-server", "open-meteo-mcp-server"],
  "calls": [
   {"name": "forecast-week", "tool": "weather_forecast", "arguments": {"latitude": 43.65, "longitude": -79.38,
     "hourly": ["temperature_2m", "precipitation_probability", "precipitation", "wind_speed_10m", "cloud_cover"],
     "daily": ["temperature_2m_max", "temperature_2m_min", "precipitation_sum", "sunrise", "sunset"],
     "current": ["temperature_2m", "wind_speed_10m", "cloud_cover"], "forecast_days": 7, "timezone": "America/Toronto"}}
  ]},
 {"id": "fetch", "command": "uvx", "args": ["mcp-server-fetch"],
