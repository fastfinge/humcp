   {"name": "wcag-understanding", "tool": "fetch", "arguments": {"url": "https://www.w3.org/WAI/standards-guidelines/wcag/", "max_length": 20000}},
   {"name": "nvda-whatsnew", "tool": "fetch", "arguments": {"url": "https://download.nvaccess.org/documentation/changes.html", "max_length": 20000}},
   {"name": "wikipedia-screen-reader", "tool": "fetch", "arguments": {"url": "https://en.wikipedia.org/wiki/Screen_reader", "max_length": 20000}}
  ]},
 {"id": "playwright", "command": "npx", "args": ["-y", "@playwright/mcp@latest", "--headless", "--isolated"],
