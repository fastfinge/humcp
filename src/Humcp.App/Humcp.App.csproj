<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Versioned since Phase 9, because the local model's runtime (Humcp.Inference, Windows ML) is,
         and Windows 11 at least: v2 does not support Windows 10 (ROADMAP §11.0). -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Humcp.App</RootNamespace>
    <AssemblyName>Humcp.App</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- humcp's own words are English only, so the framework's translated resources are not shipped. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Humcp.Core\Humcp.Core.csproj" />
    <ProjectReference Include="..\Humcp.Speech\Humcp.Speech.csproj" />
    <ProjectReference Include="..\Humcp.Inference\Humcp.Inference.csproj" />
  </ItemGroup>

  <!-- The GenAI package carries a CUDA provider and import libraries for C++ linkers. humcp runs on
       Windows ML, which has no CUDA (v2-llm-spike §3.2), and links nothing: 5 MB nobody would load. -->
  <Target Name="DropUnusedNativeFiles" AfterTargets="Publish">
    <Delete Files="$(PublishDir)onnxruntime-genai-cuda.dll;$(PublishDir)onnxruntime-genai.lib;$(PublishDir)onnxruntime-genai-cuda.lib" />
  </Target>

  <!-- What every copy of humcp carries: its own licence, the notices for what it ships, the full
       text of each of those licences, and the user guide. -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\licenses\*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\docs\user-guide.md" Link="user-guide.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
