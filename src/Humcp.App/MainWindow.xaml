<Window x:Class="Humcp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Humcp.App"
        Title="humcp"
        Height="700" Width="1040"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F6" Command="{x:Static local:MainWindow.NextPaneCommand}" />
        <KeyBinding Key="F6" Modifiers="Shift" Command="{x:Static local:MainWindow.PreviousPaneCommand}" />
        <KeyBinding Key="F1" Command="{x:Static local:MainWindow.DetailsCommand}" />
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.ReconnectCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static local:MainWindow.AddServerCommand}" />
        <KeyBinding Key="Enter" Modifiers="Alt" Command="{x:Static local:MainWindow.EditServerCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{x:Static local:MainWindow.SettingsCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:MainWindow.FindCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- A Win32 menu bar is not in the tab order: Alt reaches it and left/right arrow move
             between menus. WPF tab-stops every top-level MenuItem unless told otherwise (§7.14). -->
        <Menu DockPanel.Dock="Top" AutomationProperties.Name="Main menu"
              Focusable="False" IsTabStop="False"
              KeyboardNavigation.TabNavigation="None">
            <MenuItem Header="_File">
                <MenuItem Header="_Add server…" InputGestureText="Ctrl+N" Click="OnAddServer" />
                <MenuItem Header="_Import servers…" Click="OnImportServers" />
                <MenuItem Header="Server _settings…" InputGestureText="Alt+Enter" Click="OnEditServer" />
                <MenuItem Header="_Reconnect server" InputGestureText="F5" Click="OnReconnect" />
                <MenuItem Header="Re_move server" InputGestureText="Delete" Click="OnRemoveServer" />
                <Separator />
                <MenuItem Header="Se_ttings…" InputGestureText="Ctrl+Comma" Click="OnSettings" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Copy server _configuration" Click="OnCopyServer" />
                <MenuItem Header="Copy tool _schema" Click="OnCopySchema" />
                <Separator />
                <MenuItem Header="Clear parameter _history" Click="OnClearHistory" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Servers pane _width…" Click="OnPaneWidth" />
            </MenuItem>
            <MenuItem Header="_Tool">
                <MenuItem Header="_Find a tool…" InputGestureText="Ctrl+F" Click="OnFind" />
                <Separator />
                <MenuItem x:Name="RunMenuItem" Header="_Run" InputGestureText="Enter" Click="OnRun" />
                <MenuItem Header="_Details" InputGestureText="F1" Click="OnDetails" />
            </MenuItem>
            <MenuItem x:Name="WindowMenu" Header="_Window" />
            <MenuItem Header="_Help">
                <MenuItem Header="_User guide" Click="OnUserGuide" />
                <MenuItem Header="_Keyboard shortcuts…" Click="OnKeyboardHelp" />
                <MenuItem Header="_Speech diagnostics…" Click="OnSpeechDiagnostics" />
                <MenuItem Header="_Connection diagnostics…" Click="OnConnectionDiagnostics" />
                <Separator />
                <MenuItem Header="_About humcp" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <!-- A polite live region. Phase 0 left open whether WPF live regions alone are
                     enough or whether prism has to carry every completion (checklist item 11), so
                     both paths are wired and the manual pass decides.

                     Deliberately no AutomationProperties.Name: a TextBlock's name *is* its text,
                     and naming it "Status" would make every live-region announcement say the word
                     "Status" instead of the message. The x:Name is the automation id, which is how
                     tests find it. -->
                <TextBlock x:Name="LiveStatus"
                           AutomationProperties.LiveSetting="Polite"
                           Text="Starting." />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="420" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="ResultColumn" Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- ================================================== pane 1: servers and tools -->
            <!-- Rows, not a DockPanel, and that is a tab-order decision: a DockPanel declares what it
                 docks at the bottom before what fills the middle, and tab order follows the
                 declaration, so Run tool and Reconnect came before the tree they sit under — and,
                 from Phase 8, before the search box above it. Found by ear in Phase 8; the tool form
                 had the same defect in Phase 3 (phase3-notes 4.3, phase8-notes). -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Servers and tools" FontWeight="Bold"
                           AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,4" />

                <!-- Phase 8: §8's filter box, as a search. While it holds text, the ranked list below
                     takes the tree's place; the tree is untouched behind it and comes back on Escape.
                     No access key on the label: Alt+F is the File menu, and Ctrl+F is the key. -->
                <DockPanel Grid.Row="1" Margin="0,0,0,6">
                    <Label x:Name="SearchLabel" DockPanel.Dock="Left" Content="Find a tool:" Target="{Binding ElementName=SearchBox}"
                           Padding="0,0,6,0" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox"
                             AutomationProperties.Name="Find a tool"
                             AutomationProperties.LabeledBy="{Binding ElementName=SearchLabel}"
                             AutomationProperties.AcceleratorKey="Control plus F"
                             AutomationProperties.HelpText="Type what you want to do. Matching tools from every connected server take the tree's place, best first. Down Arrow moves to them; Escape clears the search and goes back to the tree."
                             TextChanged="OnSearchTextChanged"
                             PreviewKeyDown="OnSearchKeyDown" />
                </DockPanel>

                <Grid Grid.Row="2">
                    <!-- What a search found. Tool nodes like the tree's, named with their server, so every
                         command that works on the tree's selection works here unchanged. -->
                    <ListBox x:Name="SearchResults" Visibility="Collapsed"
                             AutomationProperties.Name="Matching tools"
                             AutomationProperties.HelpText="Best match first. Enter opens a tool's form, or runs a tool with no parameters. F1 describes it in full. Escape goes back to the search box."
                             VirtualizingStackPanel.IsVirtualizing="False"
                             SelectionMode="Single"
                             SelectionChanged="OnSearchSelectionChanged"
                             PreviewKeyDown="OnSearchResultsKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding HelpText}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AccessibleName}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <local:TypeAheadTreeView x:Name="Tree"
                              AutomationProperties.Name="Servers and tools"
                              AutomationProperties.HelpText="Arrow to a tool and press Enter. A tool with parameters opens a form; one without runs straight away. F1 describes it in full."
                              VirtualizingStackPanel.IsVirtualizing="False"
                              SelectedItemChanged="OnTreeSelectionChanged"
                              KeyDown="OnTreeKeyDown">
                        <local:TypeAheadTreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                                <!-- The whole status is in the name, so it is heard on arrow-through
                                     rather than hidden in a pane the user has to go and find (§8). -->
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding HelpText}" />
                            </Style>
                        </local:TypeAheadTreeView.ItemContainerStyle>
                        <local:TypeAheadTreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding AccessibleName}" />
                            </HierarchicalDataTemplate>
                        </local:TypeAheadTreeView.ItemTemplate>
                    </local:TypeAheadTreeView>
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="RunButton" Content="R_un tool" Click="OnRun"
                            Padding="12,4" Margin="0,0,8,0" IsEnabled="False"
                            AutomationProperties.HelpText="Runs the selected tool. A tool with parameters opens a form first. Enter does the same from the tree." />
                    <Button Content="Re_connect" Click="OnReconnect" Padding="12,4"
                            AutomationProperties.HelpText="Restarts the selected server and lists its tools again. F5." />
                </StackPanel>
            </Grid>

            <!-- For the mouse only. The keyboard route §7.14 requires is View, Servers pane width,
                 a generated form with a number in it: a focused GridSplitter never receives an
                 arrow key at all (phase6-notes), so handing it the caret was a route to nowhere. -->
            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Focusable="False" IsTabStop="False"
                          AutomationProperties.Name="Resize servers pane" />

            <!-- ================================================== pane 2: the result -->
            <DockPanel Grid.Column="2">
                <TextBlock x:Name="ResultHeading" DockPanel.Dock="Top" Text="Result" FontWeight="Bold"
                           AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,4" />

                <!-- Phase 4: a result is a set of controls rather than one box of text — a grid
                     for a table, a tree for a structure, a picture with Save and Open beside it,
                     and §7.9's read-only caret-navigable TextBox for anything that is text. -->
                <local:ResultView x:Name="MainResults" />
            </DockPanel>

        </Grid>
    </DockPanel>
</Window>
