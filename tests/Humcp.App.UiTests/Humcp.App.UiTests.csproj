<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Humcp.App.UiTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build order only. The suite launches the built executable and walks its live UIA tree; it
         does not link against the app. -->
    <!-- SkipGetTargetFrameworkProperties: since Phase 9 the app targets a versioned Windows
         framework this project has no need of, and a build-order reference is still checked for
         compatibility unless told it is only that. -->
    <ProjectReference Include="..\..\src\Humcp.App\Humcp.App.csproj"
                      ReferenceOutputAssembly="false" Private="false"
                      SkipGetTargetFrameworkProperties="true" />

    <!-- Build order only, and since Phase 6 here rather than on the app: the app connects to
         whatever its configuration names, and the suite writes a configuration naming this. -->
    <ProjectReference Include="..\Humcp.TestServer\Humcp.TestServer.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TestServerLocator.cs" Link="Shared\TestServerLocator.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
