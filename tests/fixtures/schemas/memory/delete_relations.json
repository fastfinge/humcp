            },
            "to": {
              "type": "string",
              "description": "The name of the entity where the relation ends"
            },
            "relationType": {
              "type": "string",
              "description": "The type of the relation"
            }
          },
          "required": [
            "from",
            "to",
            "relationType"
          ]
        },
