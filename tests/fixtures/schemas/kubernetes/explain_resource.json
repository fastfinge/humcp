      },
      "context": {
        "type": "string",
        "description": "Kubeconfig Context to use for the command (optional - defaults to null)",
        "default": ""
      },
      "output": {
        "type": "string",
        "description": "Output format (plaintext or plaintext-openapiv2)",
        "enum": [
          "plaintext",
          "plaintext-openapiv2"
