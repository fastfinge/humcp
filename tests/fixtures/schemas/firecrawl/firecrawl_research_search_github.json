{
  "server": "firecrawl",
  "package": "firecrawl-mcp",
  "name": "firecrawl_research_search_github",
  "title": "Search GitHub history",
  "description": "\nSearch indexed public GitHub issue, pull-request, and README content. Returns ranked matches with repository, URL, snippet, and full matched markdown when available.\n",
  "annotations": {
