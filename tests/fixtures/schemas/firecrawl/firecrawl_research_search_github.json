    "idempotentHint": null,
    "openWorldHint": true,
    "readOnlyHint": true
  },
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1
      },
      "k": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false
  },
  "outputSchema": null
}