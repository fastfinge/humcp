{
  "server": "firecrawl",
  "package": "firecrawl-mcp",
  "name": "firecrawl_monitor_checks",
  "title": "List monitor checks",
  "description": "\nList historical checks for a monitor, optionally filtered by status and bounded by a result limit. Returns one page of check summaries and pagination metadata.\n",
  "annotations": {
    "title": "List monitor checks",
    "destructiveHint": false,
    "idempotentHint": null,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "limit": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "status": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "completed",
          "failed",
          "partial",
          "skipped_overlap"
        ]
      }
    },
    "required": [
      "id"
    ],
    "additionalProperties": false
  },
  "outputSchema": null
}