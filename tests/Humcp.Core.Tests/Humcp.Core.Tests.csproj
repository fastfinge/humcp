<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Humcp.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Humcp.Core\Humcp.Core.csproj" />

    <!-- Build order only. The connection tests launch this as a real child process and speak the
         real protocol to it over a real pipe, which is the point: a fake that shares our own
         serialiser would prove much less. -->
    <ProjectReference Include="..\Humcp.TestServer\Humcp.TestServer.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TestServerLocator.cs" Link="Shared\TestServerLocator.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
